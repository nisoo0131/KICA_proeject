# Supabase Postgres connection.
# Get both from your Supabase project: Project Settings > Database > Connection string.
#
# DATABASE_URL — runtime connections. Use the Transaction pooler (port 6543) so many concurrent
# requests share a small number of server connections; session mode (5432) caps out at 15 clients
# and the dashboard/project endpoints exhaust it. `pgbouncer=true` disables prepared statements,
# which transaction mode does not support.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"

# DIRECT_URL — migrations only (prisma migrate). Must be a session-mode connection (port 5432).
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

PORT=4000

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN="http://localhost:3000"

# Signing secret for session JWTs. Must be at least 32 characters — the server refuses to start
# otherwise, since a weak or shared secret lets anyone mint valid tokens. Generate a fresh random
# value per environment, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-value-at-least-32-chars"

# Password given to every account created by `npm run prisma:seed` (12+ chars, no default).
# Seeding fails if this is unset. Only needed when running the seed, not at runtime.
SEED_USER_PASSWORD="replace-with-a-strong-seed-password"
